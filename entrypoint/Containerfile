# Cross-compilation container for entrypoint/ (the sbin/launchd replacement).
#
# The host this project is developed on is an immutable OS (rpm-ostree based)
# and this toolchain (Theos + cctools-port's Apple ld64/as port + an old
# iPhoneOS SDK) has no business being installed system-wide even on a mutable
# host — it's large, version-pinned to a specific ancient target, and only
# ever needed to rebuild this one binary. Podman keeps it fully contained.
#
# This image builds the toolchain itself (cctools-port + ldid +
# apple-libdispatch + apple-libtapi), but does NOT bake in a specific iPhoneOS
# SDK — Apple's SDKs aren't something to vendor into a committed image layer.
# The SDK is supplied at container *run* time (bind-mounted from
# entrypoint/assets/, see that directory's own README.md for provenance),
# and the actual `arm-apple-darwin11-clang` toolchain gets built as a
# one-time step inside a running container against that mounted SDK (see
# README.md in this directory) — cctools-port's own build.sh needs the real
# SDK bytes on disk to extract library stubs from, so it can't happen at
# image-build time here.
#
# Theos was tried and dropped (see README.md) — this binary is freestanding
# (-ffreestanding -nostdlib -static, no libSystem/dyld at all), and Theos's
# tool.mk template assumes exactly the opposite. All we actually need is
# cctools-port's cross-linker/assembler and ldid for ad-hoc signing.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        llvm \
        lld \
        cmake \
        git \
        autoconf \
        automake \
        libtool \
        pkg-config \
        curl \
        ca-certificates \
        xz-utils \
        unzip \
        perl \
        rsync \
        libxml2-dev \
        libssl-dev \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# glibc dropped sys/sysctl.h (deprecated in favor of /proc/sys) around
# glibc 2.30+; cctools-port's own include/foreign/sys/sysctl.h already has a
# real fallback stub for exactly this situation, but only enables it for
# __CYGWIN__. Rather than patch cctools-port's source, provide a real
# /usr/include/sys/sysctl.h matching that same existing fallback verbatim —
# a plain -1/EINVAL stub is correct here since the only caller
# (macosx_deployment_target.c) uses it to query the *host's* macOS version,
# which is meaningless when host-building on Linux in the first place.
RUN mkdir -p /usr/include/sys && printf '%s\n' \
    '#ifndef __STUB_SYS_SYSCTL_H__' \
    '#define __STUB_SYS_SYSCTL_H__' \
    '#include <errno.h>' \
    '#include <sys/types.h>' \
    '#define CTL_KERN 1' \
    '#define KERN_OSRELEASE 2' \
    'static inline int sysctl(const int *name, unsigned int namelen, void *oldp,' \
    '    size_t *oldlenp, const void *newp, size_t newlen) {' \
    '    (void)name; (void)namelen; (void)oldp; (void)oldlenp; (void)newp; (void)newlen;' \
    '    errno = EINVAL;' \
    '    return -1;' \
    '}' \
    '#endif' \
    > /usr/include/sys/sysctl.h

# cctools-port: pinned to the release tag whose bundled cctools/ld64 versions
# (877.8 / 253.9) most closely match the versions BigBoss's own historical
# "iOS Toolchain" Cydia package shipped (877.5 / 253.3, per
# https://theapplewiki.com/wiki/Dev:On-device_toolchains) — this is the same
# lineage of tooling the original jailbreak-scene binaries in this project
# (including the real sbin/launchd stub entrypoint/ replaces) were almost
# certainly built with.
ARG CCTOOLS_PORT_TAG=cctools-877.8-ld64-253.9-1
RUN git clone --branch "$CCTOOLS_PORT_TAG" --depth 1 \
        https://github.com/tpoechtrager/cctools-port.git /opt/cctools-port

# cctools' own host-side build (libstuff/macosx_deployment_target.c, used to
# query the HOST's own macOS version — meaningless when the host is Linux)
# includes <sys/sysctl.h>. cctools-port's compat shim
# (include/foreign/sys/sysctl.h) only stubs this out for __CYGWIN__ and
# otherwise #include_nexts the real header — but glibc removed
# <sys/sysctl.h> entirely in 2.30+ (this image's Debian bookworm glibc is
# 2.36), so that #include_next fails outright. Extend the same existing
# stub to Linux too.
RUN sed -i 's/#ifndef __CYGWIN__/#if !defined(__CYGWIN__) \&\& !defined(__linux__)/' \
        /opt/cctools-port/cctools/include/foreign/sys/sysctl.h

WORKDIR /work
